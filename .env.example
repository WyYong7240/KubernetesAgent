# ===========================================
# 环境变量配置模板
# 使用说明：
#   1. 复制此文件为 .env
#      cp .env.example .env
#   2. 填入你的真实 API Key
#   3. .env 已在 .gitignore 中，不会被提交到 Git
# ===========================================

# OpenAI 配置（国外用户）
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1

# 控制面配置
# FastAPI 与 Alembic 自动读取项目根目录 .env；进程环境变量优先。
# PostgreSQL 异步连接；Windows 可通过 127.0.0.1 访问 WSL 中已映射的端口。
DATABASE_URL=postgresql+asyncpg://ops_agent:ops_agent_dev@127.0.0.1:5432/kubernetes_agent
APP_ENV=development

# DAGGER 回调验签。生产环境必须设置；开发环境为空时允许本地调试。
DAGGER_WEBHOOK_SECRET=

# DeepSeek 配置（国内用户推荐）
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
